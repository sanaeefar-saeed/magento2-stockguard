<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- API service contract preferences -->
    <preference for="Saeed\StockGuard\Api\LowStockRepositoryInterface"
                type="Saeed\StockGuard\Model\LowStockRepository"/>
    <preference for="Saeed\StockGuard\Api\Data\LowStockItemInterface"
                type="Saeed\StockGuard\Model\Data\LowStockItem"/>

    <!-- Inject a dedicated logger for the module -->
    <type name="Saeed\StockGuard\Model\LowStockScanner">
        <arguments>
            <argument name="logger" xsi:type="object">Saeed\StockGuard\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Saeed\StockGuard\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Saeed\StockGuard\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">stockguard</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Saeed\StockGuard\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <!-- Console command registration -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="saeed_stockguard_scan" xsi:type="object">Saeed\StockGuard\Console\Command\ScanCommand</item>
            </argument>
        </arguments>
    </type>
</config>
